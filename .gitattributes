app/src/main/assets/docs/**/*.css text eol=lf
app/src/main/assets/docs/**/*.js text eol=lf
app/src/main/assets/docs/**/*.png binary
app/src/main/assets/docs/**/*.woff2 binary

# Icon Studio reproducible assets
